# Database
DATABASE_URL="postgresql://user:password@localhost:5432/thunder_hooves?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
# NextAuth v5 prefers AUTH_SECRET, but NEXTAUTH_SECRET is also supported for backwards compatibility
AUTH_SECRET="generate-with-openssl-rand-base64-32"
# NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"  # Legacy, use AUTH_SECRET instead

# Application
NODE_ENV="development"
PORT="3000"
